{
  "name": "inkling",
  "productName": "Inkling",
  "version": "0.5.0",
  "description": "Notes, tasks, schedule and study — together",
  "main": "out/main/index.js",
  "author": "Dominik Könitzer <dominik.koenitzer@gmail.com>",
  "license": "MIT",
  "trustedDependencies": [
    "electron",
    "better-sqlite3",
    "esbuild"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "icons": "node scripts/gen-icons.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "electron-builder install-app-deps",
    "dist": "electron-vite build && electron-builder --win nsis"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tiptap/core": "^3",
    "@tiptap/extension-highlight": "^3",
    "@tiptap/extension-list": "^3",
    "@tiptap/extensions": "^3",
    "@tiptap/pm": "^3",
    "@tiptap/react": "^3",
    "@tiptap/starter-kit": "^3",
    "better-sqlite3": "^13",
    "date-fns": "^4.1.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1",
    "react": "^19",
    "react-dom": "^19",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.26",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "app.inkling.desktop",
    "productName": "Inkling",
    "files": [
      "out/**",
      "resources/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "dominikkoenitzer",
        "repo": "Inkling"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Inkling"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "resources/icon.png",
      "category": "public.app-category.productivity",
      "x64ArchFiles": "**/node_modules/better-sqlite3/prebuilds/*.node"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "resources/icon.png",
      "category": "Office",
      "maintainer": "Dominik Könitzer"
    }
  }
}
